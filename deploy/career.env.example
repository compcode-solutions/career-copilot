# Template for /opt/apps/env/career.env on the VPS (chmod 600, never in git).
# deploy/README.md says how to fill each value. The CI workflow validates the
# compose file against this template, so the placeholders must stay non-empty.

# Required
POSTGRES_PASSWORD=change-me-hex
DOSSIER_SECRET=change-me-base64
DOSSIER_PASSWORD=argon2id:change-me-hash

# Optional (defaults are in deploy/compose.prod.yml)
# DOSSIER_IMAGE_TAG=v1.9.2
# TZ=Asia/Kolkata
# DOSSIER_BACKUP_RETENTION_DAYS=7
# DOSSIER_TELEMETRY=off
# DOSSIER_PUBLIC_URL=https://career.compcodesolutions.com

# AI provider defaults (Settings → AI provider overrides them).
# Gemini through its OpenAI-compatible endpoint:
# DOSSIER_AI_PROVIDER=openai
# DOSSIER_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOSSIER_AI_MODEL=<the Gemini model CompCode already uses>
# DOSSIER_AI_KEY=<the Gemini API key already on the VPS>
